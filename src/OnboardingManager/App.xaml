<Application x:Class="OnboardingManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Application.Resources>
</Application>

